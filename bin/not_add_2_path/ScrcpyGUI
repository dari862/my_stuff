            self._make_rounded(vdisp_box, 8)
            vdisp_box.pack(fill="x", pady=(0, 15), ipady=5)

            self._make_label(vdisp_box, "🖥️ VIRTUAL DISPLAY ENGINE", anchor="w", padx=12, pady=(8, 2))
