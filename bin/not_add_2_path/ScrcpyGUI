class ScrollableFrame(tk.Frame):
    """Pure tkinter scrollable frame using Canvas."""
    def __init__(self, parent, **kwargs):
        super().__init__(parent, **kwargs)
        self.canvas = tk.Canvas(self, highlightthickness=0, bd=0)
        self.scrollbar = ttk.Scrollbar(self, orient="vertical", command=self.canvas.yview)
        self.inner_frame = tk.Frame(self.canvas)
        self.inner_frame.bind("<Configure>", lambda e: self.canvas.configure(scrollregion=self.canvas.bbox("all")))
        self._canvas_window = self.canvas.create_window((0, 0), window=self.inner_frame, anchor="nw")
        self.canvas.configure(yscrollcommand=self.scrollbar.set)
        self.canvas.pack(side="left", fill="both", expand=True)
        self.scrollbar.pack(side="right", fill="y")
        self.canvas.bind("<Enter>", self._bind_wheel)
        self.canvas.bind("<Leave>", self._unbind_wheel)

    def _bind_wheel(self, e):
        self.canvas.bind_all("<MouseWheel>", lambda ev: self.canvas.yview_scroll(int(-ev.delta / 120), "units"))
        self.canvas.bind_all("<Button-4>", lambda ev: self.canvas.yview_scroll(-1, "units"))
        self.canvas.bind_all("<Button-5>", lambda ev: self.canvas.yview_scroll(1, "units"))

    def _unbind_wheel(self, e):
        self.canvas.unbind_all("<MouseWheel>")
        self.canvas.bind_all("<Button-4>", lambda ev: None)
        self.canvas.bind_all("<Button-5>", lambda ev: None)

    def columnconfigure(self, *args, **kwargs):
        self.inner_frame.columnconfigure(*args, **kwargs)

    def rowconfigure(self, *args, **kwargs):
        self.inner_frame.rowconfigure(*args, **kwargs)

    def grid(self, *args, **kwargs):
        raise AttributeError("Use inner_frame.grid() directly on ScrollableFrame.inner_frame")

    def update_width(self):
        self.canvas.itemconfig(self._canvas_window, width=self.canvas.winfo_width())


class SegmentedButton(tk.Frame):
    """Custom segmented button control mimicking CTkSegmentedButton."""
    def __init__(self, parent, values=None, command=None, **kwargs):
        self._theme = kwargs.pop("_theme", None)
        self._font = kwargs.pop("_font", ("Arial", 10, "bold"))
        bg = self._theme["segment_bg"] if self._theme else "#F1EFF5"
        super().__init__(parent, bg=bg, bd=0, highlightthickness=0)
        self.values = values or []
        self.command = command
        self.buttons = []
        self.selected_value = None
        for val in self.values:
            btn = tk.Button(self, text=val, font=self._font, relief="flat", bd=0, cursor="hand2",
                            command=lambda v=val: self._on_click(v))
            btn.pack(side="left", fill="both", expand=True, ipady=4)
            self.buttons.append(btn)
        if self.values:
            self.set(self.values[0])

    def _on_click(self, value):
        self.set(value)
        if self.command:
            self.command(value)

    def set(self, value):
        self.selected_value = value
        if not self._theme:
            return
        for btn, val in zip(self.buttons, self.values):
            if val == value:
                btn.configure(bg=self._theme["accent"], fg="#FFFFFF",
                              activebackground=self._theme["accent"], activeforeground="#FFFFFF")
            else:
                btn.configure(bg=self._theme["segment_bg"], fg=self._theme["segment_text"],
                              activebackground=self._theme["segment_bg"], activeforeground=self._theme["segment_text"])

    def get(self):
        return self.selected_value

    def refresh_theme(self, theme):
        self._theme = theme
        self.configure(bg=theme["segment_bg"])
        self.set(self.selected_value)


