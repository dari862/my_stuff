    # ==========================================
    # RIGHT COLUMN: RULES & MACRO SHORTCUT HOOKS
    # ==========================================
    def create_right_column(self):
        right_container = tk.Frame(self.scroll_viewport.inner_frame, bg=self.t["bg"], bd=0, highlightthickness=0)
        right_container.grid(row=0, column=2, padx=15, pady=15, sticky="nsew")

        behavior_card = self._create_card(right_container, fill="x", pady=(0, 15), ipady=10)
        self._make_label(behavior_card, "⚙️ SESSION BEHAVIOR", secondary=True, anchor="w", padx=15, pady=10)

        self.audio_codec_frame = tk.Frame(behavior_card, bg=self.t["card_bg"], bd=0, highlightthickness=0)
        tk.Label(self.audio_codec_frame, text="AUDIO CODEC", font=("Arial", 10, "bold"),
                 bg=self.t["card_bg"], fg="#845EF7").pack(side="left", padx=(20, 0))
        self._make_dropdown(self.audio_codec_frame, ["Opus", "AAC", "RAW"], self.config_state["audio_codec"],
                            lambda val: self.update_dropdown_state("audio_codec", val), width=10, side="right")

        self.record_path_frame = tk.Frame(behavior_card, bg=self.t["input_bg"],
                                          highlightbackground=self.t["input_border"], highlightthickness=1, height=32)
        self._make_rounded(self.record_path_frame, 6)
        self.record_path_frame.pack_propagate(False)

        trunc_init_path = self.config_state["recording_path"] if len(
            self.config_state["recording_path"]) <= 28 else f"...{self.config_state['recording_path'][-25:]}"
        self.lbl_path_value = tk.Label(self.record_path_frame, text=trunc_init_path, font=("Arial", 10, "bold"),
                                       bg=self.t["input_bg"], fg=self.t["text_secondary"])
        self.lbl_path_value.pack(side="left", padx=10)
        btn_browse = tk.Button(self.record_path_frame, text="BROWSE", font=("Arial", 9, "bold"),
                               bg=self.t["btn_sec_bg"], fg=self.t["text_primary"],
                               activebackground=self.t["btn_sec_hover"], activeforeground=self.t["text_primary"],
                               relief="flat", bd=0, cursor="hand2", width=8, command=self.browse_recording_path)
        btn_browse.pack(side="right", padx=5)
        btn_browse.bind("<Enter>", lambda e: btn_browse.configure(bg=self.t["btn_sec_hover"]))
        btn_browse.bind("<Leave>", lambda e: btn_browse.configure(bg=self.t["btn_sec_bg"]))

        self.behavior_rows = {}
        for text, default_on in self.config_state["session_behaviors"].items():
            row = tk.Frame(behavior_card, bg=self.t["card_bg"], bd=0, highlightthickness=0)
            row.pack(fill="x", padx=15, pady=5)
            self.behavior_rows[text] = row
            tk.Label(row, text=text, font=("Arial", 11), bg=self.t["card_bg"],
                     fg=self.t["text_primary"]).pack(side="left")
            sw = self._make_switch(row, initial=default_on,
                                   command=lambda t=text, s=None: self._delayed_switch_update(t, row))
            sw.pack(side="right")

        if self.config_state["session_behaviors"]["FORWARD AUDIO (?)"]:
            self.audio_codec_frame.pack(fill="x", padx=15, pady=(2, 6), before=self.behavior_rows["ALWAYS ON TOP (?)"])
        if self.config_state["session_behaviors"]["RECORD FEED (?)"]:
            self.record_path_frame.pack(fill="x", padx=15, pady=(2, 6), after=self.behavior_rows["RECORD FEED (?)"])

        # --- SHORTCUTS CARD ---
        shortcuts_card = self._create_card(right_container, fill="x", ipady=10)
        self._make_label(shortcuts_card, "⌨️ SHORTCUTS (ALT +)", secondary=True, anchor="w", padx=15, pady=10)

        grid_frame = tk.Frame(shortcuts_card, bg=self.t["card_bg"], bd=0, highlightthickness=0)
        grid_frame.pack(fill="x", padx=15, pady=5)
        for i in range(4):
            grid_frame.columnconfigure(i, weight=1)

        shortcut_items = [
            {"icon": "⛶", "key": "F"}, {"icon": "🏠", "key": "H"},
            {"icon": "❬", "key": "B"}, {"icon": "☰", "key": "S"},
            {"icon": "⏻", "key": "P"}, {"icon": "⟳", "key": "R"},
            {"icon": "📋", "key": "V"}, {"icon": "👁", "key": "O"}
        ]

        for index, item in enumerate(shortcut_items):
            r = index // 4
            c = index % 4
            item_box = tk.Frame(grid_frame, bg=self.t["card_bg"], bd=0, highlightthickness=0)
            item_box.grid(row=r, column=c, padx=4, pady=8, sticky="nsew")

            tk.Label(item_box, text=item["icon"], font=("Arial", 16),
                     bg=self.t["card_bg"], fg=self.t["text_primary"]).pack()

            btn_key = tk.Button(item_box, text=item["key"], font=("Arial", 10, "bold"),
                                fg=self.t["text_secondary"], bg=self.t["input_bg"],
                                activebackground=self.t["input_hover"], activeforeground=self.t["text_secondary"],
                                relief="flat", bd=0, highlightbackground=self.t["input_border"],
                                highlightthickness=1, width=3, height=1,
                                command=lambda k=item["key"]: self.on_shortcut_click(k))
            btn_key.pack(pady=(4, 0))
            btn_key.bind("<Enter>", lambda e, b=btn_key: b.configure(bg=self.t["input_hover"]))
            btn_key.bind("<Leave>", lambda e, b=btn_key: b.configure(bg=self.t["input_bg"]))

    def _delayed_switch_update(self, behavior_name, row_frame):
        for child in row_frame.winfo_children():
            if isinstance(child, tk.Frame) and hasattr(child, '_var'):
                self.update_behavior_switch(behavior_name, child)
                break


