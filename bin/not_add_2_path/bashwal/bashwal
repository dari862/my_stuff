add_saturation() {
    local r g b h l s
    read -r r g b < <(hex_to_rgb "$1")
	local amount=${2:-$SATURATE_VALUE}
	
    r=$(awk -v x="$r" 'BEGIN{printf "%.17g", x/255}')
    g=$(awk -v x="$g" 'BEGIN{printf "%.17g", x/255}')
    b=$(awk -v x="$b" 'BEGIN{printf "%.17g", x/255}')

    read -r h l s < <(rgb_to_hls "$r" "$g" "$b")

    s=$(awk -v s="$s" -v a="$amount" 'BEGIN{
        s += a
        if (s > 1) s = 1
        if (s < -1) s = -1
        printf "%.17g", s
    }')

    read -r r g b < <(hls_to_rgb "$h" "$l" "$s")

    r=$(awk -v x="$r" 'BEGIN{printf "%d", x*255}')
    g=$(awk -v x="$g" 'BEGIN{printf "%d", x*255}')
    b=$(awk -v x="$b" 'BEGIN{printf "%d", x*255}')

    rgb_to_hex "$r" "$g" "$b"
}

# Saturate all colors
saturate_colors() {
    local filtered_colors=()
    filtered_colors=("${main_colors[@]}")
    for i in "${!main_colors[@]}"; do
        if [[ "$i" -ne 7 && "$i" -ne 15 ]]; then
            filtered_colors[$i]=$(add_saturation "${main_colors[$i]}")
        fi
    done
    main_colors=("${filtered_colors[@]}")
}

