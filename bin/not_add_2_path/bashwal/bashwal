# Ensure contrast against background
hsv_to_normalized_rgb() {
    local h=$1 s=$2 v=$3

    awk -v h="$h" -v s="$s" -v v="$v" '
    BEGIN {
        if (s == 0) {
            r = g = b = v
        } else {
            h = h - int(h)      # wrap h into [0,1)
            if (h < 0) h += 1

            h *= 6
            i = int(h)
            f = h - i

            p = v * (1 - s)
            q = v * (1 - s * f)
            t = v * (1 - s * (1 - f))

            i %= 6

            if (i == 0) {
                r = v; g = t; b = p
            } else if (i == 1) {
                r = q; g = v; b = p
            } else if (i == 2) {
                r = p; g = v; b = t
            } else if (i == 3) {
                r = p; g = q; b = v
            } else if (i == 4) {
                r = t; g = p; b = v
            } else {
                r = v; g = p; b = q
            }
        }

        printf "%.17g %.17g %.17g\n", r, g, b
    }'
}

hsv_to_rgb() {
	read -r r g b < <(hsv_to_normalized_rgb "$@")
	mawk -v r="$r" -v g="$g" -v b="$b" 'BEGIN {printf "#%02x%02x%02x\n", r * 255, g * 255, b * 255}'
}

rgb_float_to_hsv() {
    mawk '
    BEGIN {
        r = ARGV[1] + 0
        g = ARGV[2] + 0
        b = ARGV[3] + 0

        max = r
        if (g > max) max = g
        if (b > max) max = b

        min = r
        if (g < min) min = g
        if (b < min) min = b

        v = max

        if (min == max) {
            printf "%.17g %.17g %.17g\n", 0, 0, v
            exit
        }

        d = max - min
        s = d / max

        rc = (max - r) / d
        gc = (max - g) / d
        bc = (max - b) / d

        if (r == max)
            h = bc - gc
        else if (g == max)
            h = 2 + rc - bc
        else
            h = 4 + gc - rc

        h /= 6

        while (h < 0)
            h += 1
        while (h >= 1)
            h -= 1

        printf "%.17g %.17g %.17g\n", h, s, v
    }' "$@"
}

hex_to_rgb_float() {
    awk -v hex="$1" '
    # mawk requires functions to be defined OUTSIDE of the BEGIN block
    function h2d(str,    out, i, c, val) {
        out = 0
        str = toupper(str)
        for (i = 1; i <= length(str); i++) {
            c = substr(str, i, 1)
            if (c ~ /[0-9]/) val = c + 0
            else if (c ~ /[A-F]/) val = index("ABCDEF", c) + 9
            else val = 0
            out = out * 16 + val
        }
        return out + 0
    }
    BEGIN {
        # Strip the leading "#" if it exists
        gsub(/^#/, "", hex)
        
        # Parse hex, divide by 255, and truncate to exactly 3 decimal places
        r = sprintf("%.3f", h2d(substr(hex, 1, 2)) / 255.0)
        g = sprintf("%.3f", h2d(substr(hex, 3, 2)) / 255.0)
        b = sprintf("%.3f", h2d(substr(hex, 5, 2)) / 255.0)
        
        # Print space-separated, exactly matching the Python f-string output
        print r, g, b
    }'
}

rgb_to_hsv(){
	read -r r g b < <(hex_to_rgb_float "$1")
	rgb_float_to_hsv "$r" "$g" "$b"
}

w3_luminance() {
    local r g b
    read -r r g b < <(hex_to_rgb "$1")
    
    awk -v r="$r" -v g="$g" -v b="$b" 'BEGIN {
        # Normalize to 0-1 with 3 decimal places (matching Python "%.3f")
        r = sprintf("%.3f", r / 255.0)
        g = sprintf("%.3f", g / 255.0)
        b = sprintf("%.3f", b / 255.0)
        
        # sRGB gamma correction
        if (r <= 0.04045) r = r / 12.92
        else r = ((r + 0.055) / 1.055) ^ 2.4
        
        if (g <= 0.04045) g = g / 12.92
        else g = ((g + 0.055) / 1.055) ^ 2.4
        
        if (b <= 0.04045) b = b / 12.92
        else b = ((b + 0.055) / 1.055) ^ 2.4
        
        # Relative luminance
        lum = 0.2126 * r + 0.7152 * g + 0.0722 * b
        
        # Print with up to 17 significant digits to exactly match Pythons output
        printf "%.17g\n", lum
    }'
}

image_average_color() {
    magick "$INPUT_IMAGE" -resize 1x1! \
        -format "%[fx:int(255*r+.5)],%[fx:int(255*g+.5)],%[fx:int(255*b+.5)]" \
        txt:- | grep -oE '#[0-9A-Fa-f]{6}'
}

binary_luminance_adjust() {
    local luminance_desired="$1"
    local hue="$2"
    local s_min="$3"
    local s_max="$4"
    local v_min="$5"
    local v_max="$6"

    local s v rgb r g b lum

    for ((i=0; i<10; i++)); do

        s=$(awk -v OFMT="%.20g" -v a="$s_min" -v b="$s_max" 'BEGIN{print (a+b)/2}')
        v=$(awk -v OFMT="%.20g" -v a="$v_min" -v b="$v_max" 'BEGIN{print (a+b)/2}')

        rgb=$(hsv_to_rgb "$hue" "$s" "$v")

        lum=$(w3_luminance "$rgb")

        if awk -v a="$lum" -v b="$luminance_desired" \
            'BEGIN{exit !(a>=b)}'
        then
            s_min="$s"
            v_max="$v"
        else
            s_max="$s"
            v_min="$v"
        fi
    done

    hsv_to_rgb "$hue" "$s" "$v"
}

ensure_contrast() {
    local colors=("${main_colors[@]}")
    local background_color
    local background_luminance
    local luminance_desired

    background_color=$(image_average_color)
    background_luminance=$(w3_luminance "$background_color")
	
    if [[ "$LIGHT_THEME" -eq 1 ]]; then
        luminance_desired=$(awk -v OFMT="%.16g" -v l="$background_luminance" -v c="$CONTRAST_VALUE" 'BEGIN{print (l+0.05)/c-0.05}')
    else
        luminance_desired=$(awk -v OFMT="%.17g" -v l="$background_luminance" -v c="$CONTRAST_VALUE" 'BEGIN{print (l+0.05)*c-0.05}')
    fi

	if ! awk -v OFMT="%.16g" -v c="$CONTRAST_VALUE" 'BEGIN { exit !(c+0==c) }'; then
    	printf '%s\n' "${colors[@]}"
    	return
	fi
	
    # Outside useful range
    if ! awk -v OFMT="%.16g" -v l="$luminance_desired" 'BEGIN{exit !(l < 0.99 && l > 0.01)}';then
    	printf '%s\n' "${colors[@]}"
    	return
	fi

    for index in $(seq 1 14); do
        local color="${colors[index]}"
        local color_lum
        color_lum=$(w3_luminance "$color")

        # Already enough contrast
        if [[ "$LIGHT_THEME" -eq 1 ]] && \
   		awk -v OFMT="%.16g" -v a="$color_lum" -v b="$luminance_desired" 'BEGIN{exit !(a<=b)}';then
    		continue
		elif awk -v OFMT="%.16g" -v a="$color_lum" -v b="$luminance_desired" 'BEGIN{exit !(a>=b)}';then
    		continue
		fi
        
        read -r h s v < <(rgb_to_hsv "$color")
        
        if [[ "$LIGHT_THEME" -eq 0 ]]; then
            # Try increasing value first
            test_color=$(hsv_to_rgb "$h" "$s" 1)
            test_lum=$(w3_luminance "$test_color")
            if awk -v OFMT="%.16g" -v a="$test_lum" -v b="$luminance_desired" 'BEGIN{exit !(a>=b)}';then
                colors[index]=$(binary_luminance_adjust "$luminance_desired" "$h" "$s" "$s" "$v" 1)
            else
                # Need to reduce saturation
                colors[index]=$(binary_luminance_adjust "$luminance_desired" "$h" 0 "$s" 1 1)
            fi

        else
            # Light theme: make darker
            colors[index]=$(binary_luminance_adjust "$luminance_desired" "$h" "$s" 1 0 "$v")
        fi
    done

    printf '%s\n' "${colors[@]}"
}

adjust_contrast(){
	local filtered_colors=()
    mapfile -t filtered_colors < <(ensure_contrast)
    main_colors=("${filtered_colors[@]}")
}

