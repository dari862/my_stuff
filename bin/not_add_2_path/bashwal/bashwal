# Generate colors trying different ImageMagick commands
gen_colors() {
    local beginning_color_count=16
    local iteration_count=20
    local max_color_count=$((beginning_color_count + iteration_count - 1))
    local color_count
    local temp_output
    local hex_colors=()
    for ((color_count=beginning_color_count;
          color_count<beginning_color_count+iteration_count;
          color_count++))
    do
        temp_output="$(magick "${INPUT_IMAGE}[0]" -resize 25% -colors "$color_count" -unique-colors txt:- 2>&1)" \
            || die "ImageMagick error."
        mapfile -t hex_colors < <(grep -oiE '#[0-9A-F]{6}' <<<"$temp_output")
        if (( ${#hex_colors[@]} >= 16 )); then
            break
        fi
        if (( color_count >= max_color_count )); then
            while (( ${#hex_colors[@]} < 16 )); do
                hex_colors+=("${hex_colors[@]}")
            done
        fi
    done
    (( ${#hex_colors[@]} == 0 )) && \
        die "Failed to generate palette from image."
    raw_colors=("${hex_colors[@]}")
}

# Get colorscheme from image
getwal() {
	local filtered_colors=()
    local c h
	if [ -f "$cache_file" ];then
		source "$cache_file"
		for h in "${raw_colors[@]}"; do
        	filtered_colors+=("#${h}")
    	done
	else
    	gen_colors
    	for c in "${raw_colors[@]}"; do
        	[[ "$c" == "# Image" ]] && continue
        	filtered_colors+=("$c")
    	done
    	echo "raw_colors=(${filtered_colors[@]})" | sed 's/#//g' > "$cache_file"
    fi
    raw_colors=("${filtered_colors[@]}")
    generic_adjust
    main_colors=("${raw_colors[@]}")
}

# Main color generation function
getcolors() {
    log_info "Generating a colorscheme for: $image_name."
    sub_log_info "${cols16_method_massage}"
    
    if [[ -n "$SATURATE_VALUE" ]]; then
    	sub_log_info "${saturation_value_massage}"
    fi
    if [[ -n "$CONTRAST_VALUE" ]]; then
    	sub_log_info "${contrast_value_massage}"
    fi
    if [[ "$LIGHT_THEME" -eq 1 ]]; then
    	sub_log_info "${light_theme_massage}"
    fi
    
    getwal
    
    # Saturate colors
    if [[ -n "$SATURATE_VALUE" ]]; then
    	log_info "Adding saturation."
    	saturate_colors
    fi
    
    # Ensure contrast
    if [[ -n "$CONTRAST_VALUE" ]]; then
    	log_info "Adding Contrast."
    	adjust_contrast
    fi
    
    log_info "Generation complete."
}

# Create colors output file
createcolorsfile() {
    {
        printf "alpha='100'\n"
        local i
        for ((i=0;i<16;i++)); do
            printf "color%d='%s'\n" "$i" "${main_colors[$i]}"
        done
    } >"$OUTPUT_FILE"
    
    log_info "Successfully created colors file at $OUTPUT_FILE"
    log_info "Export finished. Template system bypassed."
}

# Print palette preview
print_palette() {
    echo ""
    for i in {0..15}; do
        if [[ $((i % 8)) -eq 0 ]]; then
            echo ""
        fi
        local idx="$i"
        if [[ $i -gt 7 ]]; then
            idx="8;5;$i"
        fi
        printf "\033[4%sm    \033[0m" "$idx"
    done
    echo -e "\n"
}

# Main function
main() {
    parse_args "$@"
    
    getcolors
    
    createcolorsfile
    
    # Print palette preview if stdout is a terminal
    if [[ -t 1 ]]; then
        print_palette
    fi
}

# Run main function
main "$@"
