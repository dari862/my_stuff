saturate_all_colors() {
	local colors=("${main_colors[@]}")
	for i in "${!colors[@]}"; do
       	if [[ "$i" -ne 7 && "$i" -ne 15 ]]; then
           	main_colors[$i]=$(saturate_color "${colors[$i]}")
       	fi
    done
}

