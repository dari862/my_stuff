# Generate colors trying different ImageMagick commands
gen_colors() {
    local max_color_count=35
    local color_count=16
    local temp_output=""
    local hex_colors=()
    
    local temp_resized="/tmp/resized_${base}.miff"
    magick "${INPUT_IMAGE}[0]" -resize 25% "mpc:$temp_resized"
    
    for (( color_count; color_count<=max_color_count; color_count++ )); do # iteration count 20
        mapfile -t hex_colors < <(magick "mpc:$temp_resized" -colors "$color_count" -unique-colors txt:- | grep -oiE '#[0-9A-F]{6}')
        if (( ${#hex_colors[@]} >= 16 )); then
            break
        fi
        if (( color_count >= max_color_count )); then
            while (( ${#hex_colors[@]} < 16 )); do
                hex_colors+=("${hex_colors[@]}")
            done
        fi
    done
    (( ${#hex_colors[@]} == 0 )) && \
        die "Failed to generate palette from image."
    
    local c
    filtered_colors=()
    for c in "${hex_colors[@]}"; do
        [[ "$c" == "# Image" ]] && continue
    	filtered_colors+=("$c")
    done
    
	local normal_mode_colors=()
    local light_mode_colors=()
    
    # light theme
    light_mode_colors+=("${filtered_colors[0]}")
    for i in {8..15}; do
       	light_mode_colors+=("${filtered_colors[$i]}")
    done
    	
    for i in {8..14}; do
       	light_mode_colors+=("${filtered_colors[$i]}")
    done
    	
    light_mode_colors[0]=$(lighten_color "${light_mode_colors[0]}" 0.95)
    light_mode_colors[7]=$(darken_color "${light_mode_colors[0]}" 0.50)
	light_mode_colors[8]=$(darken_color "${light_mode_colors[0]}" 0.25)
	light_mode_colors[15]=$(darken_color "${light_mode_colors[0]}" 0.75)

    {
    	printf 'light_mode_colors=('
    	printf '"%s" ' "${light_mode_colors[@]}"
    	printf ')\n'
	} > "$cache_file"
    
    # normal theme
    normal_mode_colors+=("${filtered_colors[0]}")
    local i
    for ((i=8;i<16;i++)); do
       	normal_mode_colors+=("${filtered_colors[$i]}")
    done
    for ((i=8;i<${#filtered_colors[@]}-1;i++)); do
       	normal_mode_colors+=("${filtered_colors[$i]}")
    done
    if [[ "${normal_mode_colors[0]:1:1}" != "0" ]]; then
       	normal_mode_colors[0]="$(darken_color "${normal_mode_colors[0]}" 0.40)"
    fi
    local saturate_more=0
    [[ "${normal_mode_colors[0]:1:1}" == "0" ]] && saturate_more=1
    [[ "${normal_mode_colors[0]:3:1}" == "0" ]] && saturate_more=1
    [[ "${normal_mode_colors[0]:5:1}" == "0" ]] && saturate_more=1
    if (( saturate_more )); then
       	normal_mode_colors[0]="$(lighten_color "${normal_mode_colors[0]}" 0.03)"
      	normal_mode_colors[0]="$(saturate_color "${normal_mode_colors[0]}" 0.40)"
    fi
    normal_mode_colors[7]="$(lighten_color "${normal_mode_colors[0]}" 0.55)"
	normal_mode_colors[7]="$(saturate_color "${normal_mode_colors[7]}" 0.05)"
	normal_mode_colors[8]="$(lighten_color "${normal_mode_colors[0]}" 0.35)"
 	normal_mode_colors[8]="$(saturate_color "${normal_mode_colors[8]}" 0.10)"
	normal_mode_colors[15]="$(lighten_color "${normal_mode_colors[0]}" 0.75)"
	
	{
    	printf 'normal_mode_colors=('
    	printf '"%s" ' "${normal_mode_colors[@]}"
    	printf ')\n'
	} >> "$cache_file"
}

apply_cols16_method(){
	if [[ "$COLS16_METHOD" == "lighten" || "$COLS16_METHOD" == "dual" ]]; then
		#Shade colors (lighten) for 16 color scheme
		local i
    	for ((i=1;i<=6;i++)); do
        	main_colors[$((i+8))]="$(lighten_color "${main_colors[$i]}" 0.25)"
    	done
    	if [[ "$LIGHT_THEME" -eq 0 ]]; then
    		for ((i=9;i<=14;i++)); do
        		main_colors[$i]="$(saturate_color "${main_colors[$i]}" 0.40)"
    		done
    	fi
	fi
	if [[ "$COLS16_METHOD" == "darken" || "$COLS16_METHOD" == "dual" ]]; then
		#Shade colors (darken) for 16 color scheme
		local i
    	for ((i=1;i<=6;i++)); do
        	main_colors[$i]="$(darken_color "${main_colors[$i]}" 0.25)"
    	done 
	fi
}

# Main color generation function
getcolors() {
    log_info "Generating a colorscheme for: $image_name."
    sub_log_info "${cols16_method_massage}"
    
    if [[ -n "$SATURATE_VALUE" ]]; then
    	sub_log_info "${saturation_value_massage}"
    fi
    if [[ -n "$CONTRAST_VALUE" ]]; then
    	sub_log_info "${contrast_value_massage}"
    fi
    if [[ "$LIGHT_THEME" -eq 1 ]]; then
    	sub_log_info "${light_theme_massage}"
    fi
    
    local light_mode_colors=()
	local normal_mode_colors=()
	
	if [ ! -f "$cache_file" ];then		
		gen_colors
    fi
    
    source "$cache_file"
    
    if [[ "$LIGHT_THEME" -eq 1 ]]; then
    	main_colors=("${light_mode_colors[@]}")
    else
    	main_colors=("${normal_mode_colors[@]}")
    fi
    
    apply_cols16_method
    
    # Saturate colors
    if [[ -n "$SATURATE_VALUE" ]]; then
    	log_info "Adding saturation."
    	saturate_all_colors
    fi
    
    # Ensure contrast
    if [[ -n "$CONTRAST_VALUE" ]]; then
    	log_info "Adding Contrast."
    	adjust_contrast
    fi
    
    log_info "Generation complete."
}

# Create colors output file
createcolorsfile() {
    {
        printf "alpha='100'\n"
        local i
        for ((i=0;i<16;i++)); do
            printf "color%d='%s'\n" "$i" "${main_colors[$i]}"
        done
    } >"$OUTPUT_FILE"
    
    log_info "Successfully created colors file at $OUTPUT_FILE"
    log_info "Export finished. Template system bypassed."
}

# Print palette preview
print_palette() {
    echo ""
    for i in {0..15}; do
        if [[ $((i % 8)) -eq 0 ]]; then
            echo ""
        fi
        local idx="$i"
        if [[ $i -gt 7 ]]; then
            idx="8;5;$i"
        fi
        printf "\033[4%sm    \033[0m" "$idx"
    done
    echo -e "\n"
}

# Main function
main() {
    parse_args "$@"
    
    getcolors
    
    createcolorsfile
    
    # Print palette preview if stdout is a terminal
    if [[ -t 1 ]]; then
        print_palette
    fi
}

# Run main function
main "$@"
