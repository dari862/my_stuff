#!/usr/bin/env bash
unalias -a
set -e

# Global variables
declare -a main_colors=()
declare -a raw_colors=()
COLS16_METHOD="darken"
SATURATE_VALUE=""
CONTRAST_VALUE=""
INPUT_IMAGE=""
OUTPUT_FILE="/tmp/colors.sh"
LIGHT_THEME=0
ALPHA_NUM="100"
image_name=""
cols16_method_massage="cols16 method are $COLS16_METHOD"
saturation_value_massage=""
contrast_value_massage=""
light_theme_massage=""
cache_dir="$HOME/.cache/bashwal"
cache_file=""
# Logging functions
log_info() {
    echo -e "\033[1;32mI\033[0m \033[1;31m${0##*/}\033[0m: $*" >&2
}

sub_log_info() {
    echo -e "		$*" >&2
}

log_warn() {
    echo -e "\033[1;33mW\033[0m \033[1;31m${0##*/}\033[0m: $*" >&2
}

log_error() {
    echo -e "\033[1;31mE\033[0m \033[1;31m${0##*/}\033[0m: $*" >&2
}

die() {
    log_error "$*"
    exit 1
}

# Show help
show_help() {
    cat << 'EOF'
Usage: colorgen.sh [OPTIONS]

Options:
  --cols16 [method]     Use 16 color output "darken", "lighten" or "dual" default: darken
  --saturate [Value]    Set the color saturation. values between -1.0 and 1.0
  --contrast [Value]    Specify a minimum contrast ratio between palette colors and
                        the source image according to W3 contrast specifications.
                        Values between 1.5-4.5 typically work best. values between 0 and 21.0
  -i "/path/to/img.jpg" Which image or directory to use.
  -o "/path/to/output"  Direct path to the output of file
  -l                    Generate a light colorscheme.
  -h, --help            Show this help message
EOF
    exit 0
}

# Parse command line arguments
parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --cols16)
                COLS16_METHOD="${2:-darken}"
                cols16_method_massage="cols16 method are $COLS16_METHOD"
                if [[ "$COLS16_METHOD" != "darken" && "$COLS16_METHOD" != "lighten" && "$COLS16_METHOD" != "dual" ]]; then
                    die "Invalid --cols16 method: $COLS16_METHOD"
                fi
                shift 2
                ;;
            --saturate)
                SATURATE_VALUE="$2"
                if [[ -z "$SATURATE_VALUE" ]];then
                	die "Set the color saturation. values between -1.0 and 1.0"
                fi
                shift 2
                local check
    			check=$(awk "BEGIN {print ($SATURATE_VALUE <= 1.0 && $SATURATE_VALUE >= -1.0) ? 1 : 0}")
    			if [[ "$check" -eq 0 ]]; then
    				log_error "Invalid color saturation value: $SATURATE_VALUE" 
    				die "Set the color saturation. values between -1.0 and 1.0"
				fi
				saturation_value_massage="Saturation value are $SATURATE_VALUE"
                ;;
            --contrast)
            	CONTRAST_VALUE="$2"
            	if [[ -z "$CONTRAST_VALUE" ]];then
                	die "Set the color contrast. values between 0 and 21.0"
                fi
            	shift 2
            	local in_range
    			in_range=$(awk "BEGIN {print ($CONTRAST_VALUE >= 1 && $CONTRAST_VALUE <= 21) ? 1 : 0}")
    			if [[ "$in_range" -eq 0 ]]; then
        			log_error "Invalid color contrast value: $CONTRAST_VALUE" 
    				die "Set the color contrast. values between 0 and 21.0"
    			fi
    			contrast_value_massage="Contrast value are $CONTRAST_VALUE"
                ;;
            -i)
                INPUT_IMAGE="$2"
                image_name="$(basename "$INPUT_IMAGE")"
                cache_file="${cache_dir}/${image_name}.txt"
                if [ ! -d "$cache_dir" ];then
                	mkdir -p "$cache_dir"
                fi
                shift 2
                ;;
            -o)
                OUTPUT_FILE="$2"
                shift 2
                ;;
            -l)
                LIGHT_THEME=1
                light_theme_massage="Using Light theme."
                shift
                ;;
            -h|--help)
                show_help
                ;;
            *)
                log_error "Unknown option: $1"
                show_help
                ;;
        esac
    done

    if [[ -z "$INPUT_IMAGE" ]]; then
        show_help
    fi

    # Get absolute path
    if [[ "$INPUT_IMAGE" != /* ]]; then
        INPUT_IMAGE="$(pwd)/$INPUT_IMAGE"
    fi
}

rgb_to_hex() {
    printf "#%02x%02x%02x\n" "$1" "$2" "$3"
}

hex_to_rgb() {
    local color="${1#\#}"
	local r g b
    if [[ ! "$color" =~ ^[0-9a-fA-F]{6}$ ]]; then
        echo "Invalid hex color: $1" >&2
        return 1
    fi

    r=$((16#${color:0:2}))
    g=$((16#${color:2:2}))
    b=$((16#${color:4:2}))
    printf "%s %s %s" "$r" "$g" "$b"
}

darken_color() {
    local r g b
    read -r r g b < <(hex_to_rgb "$1")
    # Convert amount (e.g., 0.2) to a percentage multiplier (e.g., 20)
    # This strips the "0." and treats it as an integer percentage
    local amount_pct
    amount_pct="$((10#${2//./}))"

    # Apply the formula: r = r * (100 - amount_pct) / 100
    r=$(( r * (100 - amount_pct) / 100 ))
    g=$(( g * (100 - amount_pct) / 100 ))
    b=$(( b * (100 - amount_pct) / 100 ))

    rgb_to_hex "$r" "$g" "$b"
}

lighten_color() {
    local r g b
    read -r r g b < <(hex_to_rgb "$1")
    local amount_pct
    amount_pct="$((10#${2//./}))"

    # Apply the formula: r = r + (255 - r) * amount_pct / 100
    r=$(( r + (255 - r) * amount_pct / 100 ))
    g=$(( g + (255 - g) * amount_pct / 100 ))
    b=$(( b + (255 - b) * amount_pct / 100 ))

    rgb_to_hex "$r" "$g" "$b"
}

saturate_color() {
    local r g b
    read -r r g b < <(hex_to_rgb "$1")

    read -r r g b < <(
        awk -v r="$r" -v g="$g" -v b="$b" \
            -v sat="$2" -v add="$SATURATE_VALUE" '
        function hue2rgb(m1,m2,h) {
            if (h < 0) h += 1
            if (h > 1) h -= 1

            if (h < 1.0/6.0)
                return m1 + (m2-m1)*h*6
            if (h < 0.5)
                return m2
            if (h < 2.0/3.0)
                return m1 + (m2-m1)*(2.0/3.0-h)*6
            return m1
        }

        BEGIN {
            # Normalize
            r /= 255
            g /= 255
            b /= 255

            # RGB -> HLS
            maxc = r
            if (g > maxc) maxc = g
            if (b > maxc) maxc = b

            minc = r
            if (g < minc) minc = g
            if (b < minc) minc = b

            l = (minc + maxc) / 2

            if (minc == maxc) {
                h = 0
                s = 0
            } else {
                if (l <= 0.5)
                    s = (maxc-minc)/(maxc+minc)
                else
                    s = (maxc-minc)/(2-maxc-minc)

                rc = (maxc-r)/(maxc-minc)
                gc = (maxc-g)/(maxc-minc)
                bc = (maxc-b)/(maxc-minc)

                if (r == maxc)
                    h = bc-gc
                else if (g == maxc)
                    h = 2+rc-bc
                else
                    h = 4+gc-rc

                h /= 6
                h -= int(h)
                if (h < 0) h += 1
            }

            # Saturation adjustment
            if (sat != "")
                s = sat
            else {
                s += add
                if (s > 1) s = 1
                if (s < -1) s = -1
            }

            # HLS -> RGB
            if (s == 0) {
                r = g = b = l
            } else {
                if (l <= 0.5)
                    m2 = l * (1+s)
                else
                    m2 = l + s - l*s

                m1 = 2*l - m2

                r = hue2rgb(m1,m2,h+1.0/3.0)
                g = hue2rgb(m1,m2,h)
                b = hue2rgb(m1,m2,h-1.0/3.0)
            }

            printf "%d %d %d\n", r*255, g*255, b*255
        }'
    )

    rgb_to_hex "$r" "$g" "$b"
}

