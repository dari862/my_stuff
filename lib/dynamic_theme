#!/bin/sh
xrgba_it() {
   	hex=$1
   	# Extract the two-digit hex values and convert to decimal
	r=$(echo "$hex" | cut -c 1-2)
   	g=$(echo "$hex" | cut -c 3-4)
   	b=$(echo "$hex" | cut -c 5-6)
   	
   	echo "$r/$g/$b/ff"
}
	
strip_it(){
	echo "$1" | sed 's/#//g'
}

