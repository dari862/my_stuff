dynamic_check_theme_files(){
	
	GLOBALDYNAMICBLOBPATH="${__distro_path_all_distro_themes}/dynamic_theme"
	
	if [ ! -d "$gtk_theme_path/dynamic" ];then
		mkdir -p "$gtk_theme_path/dynamic"
		cp -r "${GLOBALDYNAMICBLOBPATH}"/themes/* "$gtk_theme_path" || show_em "failed to cp -r \"${GLOBALDYNAMICBLOBPATH}\" \"${gtk_theme_path}\""
	fi
	
	if [ ! -d "$gtk_icon_path/dynamic" ];then
		mkdir -p "$gtk_icon_path/dynamic"
		cp -r "${GLOBALDYNAMICBLOBPATH}"/icons/* "$gtk_icon_path" || show_em "failed to cp -r \"${GLOBALDYNAMICBLOBPATH}\" \"${gtk_icon_path}\""
	fi
}

gtk_theme_builder(){
	gtk_theme_path="$HOME/.themes"
