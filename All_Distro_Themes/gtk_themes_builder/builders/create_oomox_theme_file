#!/bin/sh
set -e

current_path="$(dirname "$0")"
path_to_my_oomox_files="$HOME/Desktop/workon/oomox_files"

if [ -d "$path_to_my_oomox_files/oomox_gui/colors/zzmythemes" ];then
	oomox_files_path="$path_to_my_oomox_files/oomox_gui/colors/zzmythemes"
elif [ -d "$HOME/.config/oomox/colors/zzmythemes" ];then
	oomox_files_path="$HOME/.config/oomox/colors/zzmythemes"
else
	echo "no dir found. "
	exit
fi

list_of_base_GTK_theme="$(find "${current_path}/source_base" -type f || :)"
mkdir -p "${oomox_files_path}"

for t in ${list_of_base_GTK_theme};do
	. "$t"
	style_name="${t##*/}"
	style_path="${oomox_files_path}/${style_name}"
	tee "$style_path" <<-EOF >/dev/null 2>&1
	BASE16_GENERATE_DARK=False
	BASE16_INVERT_TERMINAL=False
	BASE16_MILD_TERMINAL=False
	ICONS_ARCHDROID=00BCD4
	ICONS_NUMIX_STYLE=0
	ICONS_STYLE=gnome_colors
	ICONS_SYMBOLIC_ACTION=CFD8DC
	ICONS_SYMBOLIC_PANEL=CFD8DC
	SURUPLUS_GRADIENT1=CFD8DC
	SURUPLUS_GRADIENT2=00BCD4
	SURUPLUS_GRADIENT_ENABLED=False
	EOF

	tee -a "$style_path" <<-EOF >/dev/null 2>&1
	ACCENT_BG="$ACCENT_BG"
	BG="$BG"
	BTN_BG="$BTN_BG"
	BTN_FG="$BTN_FG"
	BTN_OUTLINE_OFFSET="$BTN_OUTLINE_OFFSET"
	BTN_OUTLINE_WIDTH="$BTN_OUTLINE_WIDTH"
	CARET1_FG="$CARET1_FG"
	CARET2_FG="$CARET2_FG"
	CARET_SIZE="$CARET_SIZE"
	CINNAMON_OPACITY="$CINNAMON_OPACITY"
	FG="$FG"
	GRADIENT="$GRADIENT"
	GTK3_GENERATE_DARK="$GTK3_GENERATE_DARK"
	HDR_BG="$HDR_BG"
	HDR_BTN_BG="$HDR_BTN_BG"
	HDR_BTN_FG="$HDR_BTN_FG"
	HDR_FG="$HDR_FG"
	ICONS_DARK="$ICONS_DARK"
	ICONS_LIGHT="$ICONS_LIGHT"
	ICONS_LIGHT_FOLDER="$ICONS_LIGHT_FOLDER"
	ICONS_MEDIUM="$ICONS_MEDIUM"
	MATERIA_PANEL_OPACITY="$MATERIA_PANEL_OPACITY"
	MATERIA_SELECTION_OPACITY="$MATERIA_SELECTION_OPACITY"
	MATERIA_STYLE_COMPACT="$MATERIA_STYLE_COMPACT"
	MENU_BG="$MENU_BG"
	MENU_FG="$MENU_FG"
	NAME="$NAME"
	OUTLINE_WIDTH="$OUTLINE_WIDTH"
	ROUNDNESS="$ROUNDNESS"
	SEL_BG="$SEL_BG"
	SEL_FG="$SEL_FG"
	SPACING="$SPACING"
	TXT_BG="$TXT_BG"
	TXT_FG="$TXT_FG"
	UNITY_DEFAULT_LAUNCHER_STYLE="$UNITY_DEFAULT_LAUNCHER_STYLE"
	WM_BORDER_FOCUS="$WM_BORDER_FOCUS"
	WM_BORDER_UNFOCUS="$WM_BORDER_UNFOCUS"
	THEME_STYLE="$THEME_STYLE"
	EOF
	
	if [ "$THEME_STYLE" = "materia" ];then
		tee -a "$style_path" <<-EOF >/dev/null 2>&1
		SPOTIFY_PROTO_BG="$SPOTIFY_PROTO_BG"
		SPOTIFY_PROTO_FG="$SPOTIFY_PROTO_FG"
		SPOTIFY_PROTO_SEL="$SPOTIFY_PROTO_SEL"
		TERMINAL_ACCENT_COLOR="$TERMINAL_ACCENT_COLOR"
		TERMINAL_BACKGROUND="$TERMINAL_BACKGROUND"
		TERMINAL_BASE_TEMPLATE="$TERMINAL_BASE_TEMPLATE"
		TERMINAL_COLOR0="$TERMINAL_COLOR0"
		TERMINAL_COLOR1="$TERMINAL_COLOR1"
		TERMINAL_COLOR10="$TERMINAL_COLOR10"
		TERMINAL_COLOR11="$TERMINAL_COLOR11"
		TERMINAL_COLOR12="$TERMINAL_COLOR12"
		TERMINAL_COLOR13="$TERMINAL_COLOR13"
		TERMINAL_COLOR14="$TERMINAL_COLOR14"
		TERMINAL_COLOR15="$TERMINAL_COLOR15"
		TERMINAL_COLOR2="$TERMINAL_COLOR2"
		TERMINAL_COLOR3="$TERMINAL_COLOR3"
		TERMINAL_COLOR4="$TERMINAL_COLOR4"
		TERMINAL_COLOR5="$TERMINAL_COLOR5"
		TERMINAL_COLOR6="$TERMINAL_COLOR6"
		TERMINAL_COLOR7="$TERMINAL_COLOR7"
		TERMINAL_COLOR8="$TERMINAL_COLOR8"
		TERMINAL_COLOR9="$TERMINAL_COLOR9"
		TERMINAL_CURSOR="$TERMINAL_CURSOR"
		TERMINAL_FOREGROUND="$TERMINAL_FOREGROUND"
		TERMINAL_THEME_ACCURACY="$TERMINAL_THEME_ACCURACY"
		TERMINAL_THEME_AUTO_BGFG="$TERMINAL_THEME_AUTO_BGFG"
		TERMINAL_THEME_EXTEND_PALETTE="$TERMINAL_THEME_EXTEND_PALETTE"
		TERMINAL_THEME_MODE="$TERMINAL_THEME_MODE"
		EOF
	fi
done
