#!/bin/bash
unalias -a
set -e

arg="${1:-}"
__mode="cli"

. "$__distro_path_lib"
. "${__distro_path_root}/lib/automount_lib"

if [ "$(id -u)" -eq 0 ]; then
	show_em "❌ This script should never be run as super user."
fi

export FZF_CTRL_R_OPTS=""
export FZF_DEFAULT_OPTS=""

Parse_arguments
fill_unmounted_devices_var

selected_line=""
if command -v fzf >/dev/null 2>&1; then
	selected_line=$(print_unmounted_devices | fzf --prompt="Select device to mount: " | awk '{print $2}')
else
	show_m "📦 Select device to mount:"
	print_unmounted_devices
	printf "Enter the number of the device to mount: "
	read -r idx
	case "$idx" in
		''|*[!0-9]*) show_em "❌ Invalid selection.";;
	esac
	selected_line=$(print_unmounted_devices | grep "\[${idx}\]" | awk '{print $2}')
fi

get_uuid_and_fs_type

mount_path=""
printf '%s\n' "Enter mount point (blank = auto-generate): "
read -r mount_path

check_mount_path_and_fs_type

show_m ""
show_m "🔍 Planned Actions:"
show_m "------------------"
show_m "Selected Device : $device_path"
show_m "UUID            : $uuid"
show_m "Filesystem Type : $fs_type"
show_m "Mount Point     : $mount_path"
show_m "Mount Options   : $options"
show_m "fstab Entry     : UUID=$uuid $mount_path $fs_type $options 0 2"

run_automount
